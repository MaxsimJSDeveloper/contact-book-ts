generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String?
  name      String
  avatarUrl String?
  contacts  Contact[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("users")
}

enum ContactType {
  work
  home
  personal
}

model Contact {
  id          String      @id @default(uuid())
  name        String
  phoneNumber String
  email       String?
  isFavourite Boolean     @default(false)
  contactType ContactType @default(personal)
  photo       String?
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("contacts")
}